# Copy to .env and edit. Every value below has a working default, so the app
# runs with no .env at all — keyless, against the scripted mock model.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://deskhand:deskhand@localhost:5437/deskhand

# --- Model ----------------------------------------------------------------
# Leave ANTHROPIC_API_KEY unset to run against the scripted mock provider.
# The mock is not a silent stub: every run it drives is tagged provider=mock
# in the API response and in the run viewer, so a demo can never be mistaken
# for a real model call.
# ANTHROPIC_API_KEY=sk-ant-...
MODEL_ID=claude-opus-5
MODEL_EFFORT=high

# --- Run bounds -----------------------------------------------------------
# Per-run ceilings. A run that hits any of these lands in the `exhausted`
# terminal state with the specific bound named, never a silent stall.
MAX_STEPS_PER_RUN=24
MAX_TOKENS_PER_RUN=400000
MAX_WALLCLOCK_SECONDS_PER_RUN=900
MAX_SPEND_USD_PER_RUN=2.00

# Repeated identical tool calls before the runtime calls it a loop.
LOOP_DETECTION_THRESHOLD=3

# --- Spend ceilings -------------------------------------------------------
# Per-org daily cap, and the one that actually bounds the deployment's bill.
DAILY_BUDGET_USD_PER_ORG=10.00
PLATFORM_DAILY_BUDGET_USD=50.00

# --- Approvals ------------------------------------------------------------
# An irreversible tool call suspends the run until a human decides. If nobody
# does within this window the run fails with `approval_expired` — a distinct
# terminal reason, never a silent denial.
APPROVAL_TTL_SECONDS=86400

# --- Observability --------------------------------------------------------
# Nothing to configure. Every model call and tool call is a row in `steps`
# carrying tokens, cost, latency, arguments and result, and the runtime emits a
# structured JSON line per event on the `deskhand.events` logger for whatever
# collects your logs.
